---
// Squelette commun à toutes les pages : <head>, lien d'évitement, header, footer.
// Le contenu de la page (<main>…</main>) est passé dans le slot.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';

interface Props {
  title: string;
  description?: string;
  /** href de la page active dans le menu ('/', '/projets/', '/a-propos/') */
  current?: string;
  /** Volet académique : jamais indexé */
  noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..700;1,9..144,500..700&family=Gochi+Hand&family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,600;1,400&display=swap" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <Header current={current} />

    <slot />

    <Footer />

    <script>
      import '../main.js';
    </script>
  </body>
</html>
