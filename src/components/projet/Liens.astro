---
// Section « Les liens » : site en ligne, GitHub, Figma, Behance…
// Le premier lien est mis en avant.

interface Props {
  titre?: string;
  liens: { href: string; label: string }[];
}

const { titre = 'Les liens', liens } = Astro.props;
---

<section class="section" aria-labelledby="liens">
  <div class="container stack reveal">
    <h2 id="liens">{titre}</h2>
    <ul class="case-links list-reset" role="list">
      {liens.map((lien, i) => (
        <li><a class={i === 0 ? 'btn' : 'btn btn--ghost'} href={lien.href}>{lien.label} <span aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
  </div>
</section>
