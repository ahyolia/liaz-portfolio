---
// Gabarit d'une fiche projet : layout du site + feuille blanche (.case-sheet)
// + navigation « Projet suivant » en bas, calculée depuis src/data/projets.js.
// Les sections (CaseHero, Contexte, Questions, Demarche, Apport, Galerie, Liens)
// se placent dans le slot, dans l'ordre voulu.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lienProjet, projetSuivant } from '../../data/projets.js';

interface Props {
  /** Identifiant du projet dans src/data/projets.js */
  slug: string;
  title: string;
  description?: string;
}

const { slug, title, description } = Astro.props;
const suivant = projetSuivant(slug);
---

<BaseLayout title={title} description={description} current="/projets/">
  <main id="contenu">
    <article class="case-sheet">
      <slot />

      <nav class="container project-nav" aria-label="Autres projets">
        <a class="project-nav__link" href="/projets/"><span aria-hidden="true">←</span> Tous les projets</a>
        {suivant && suivant.slug !== slug && (
          <a class="project-nav__link project-nav__link--next" href={lienProjet(suivant)}>
            <span class="project-nav__label">Projet suivant</span> {suivant.titre} <span aria-hidden="true">→</span>
          </a>
        )}
      </nav>
    </article>
  </main>
</BaseLayout>
