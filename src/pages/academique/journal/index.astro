---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Journal des fiches de réflexion — Camélia Amin Handoyo"
  noindex
>
<main id="contenu">
  <p class="academic-banner">Espace réservé à l'équipe pédagogique — BUT MMI</p>

  <section class="section" aria-labelledby="titre-page">
    <div class="container stack" style="--flow: var(--space-l)">
      <nav aria-label="Volet académique">
        <ul class="academic-nav">
          <li><a href="/academique/">Compétences et AC</a></li>
          <li><a href="/academique/journal/" aria-current="page">Journal des fiches</a></li>
        </ul>
      </nav>

      <header class="stack">
        <p class="eyebrow">Volet académique</p>
        <h1 id="titre-page">Journal des fiches de réflexion</h1>
        <p class="lead">Une fiche par projet ou situation d'apprentissage. <span class="todo">À REMPLACER</span></p>
      </header>

      <!-- Une carte = une fiche. Dupliquer un <li> pour en ajouter (et déclarer la page dans vite.config.js). -->
      <ul class="grid list-reset" role="list">
        <li class="card postit postit--cream stack reveal">
          <span class="tape" aria-hidden="true"></span>
          <p><time datetime="2026-10-15">15 octobre 2026</time></p>
          <h2><a class="card__link" href="/academique/journal/fiche-exemple.html">Fiche exemple</a></h2>
          <ul class="tags"><li>AC34.01</li><li>AC34.02</li><li>AC35.01</li></ul>
          <p><span class="todo">À REMPLACER</span></p>
        </li>
      </ul>
    </div>
  </section>
</main>
</BaseLayout>
