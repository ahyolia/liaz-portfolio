---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Volet académique — Compétences — Camélia Amin Handoyo"
  noindex
>
<main id="contenu">
  <p class="academic-banner">Espace réservé à l'équipe pédagogique — BUT MMI</p>

  <section class="section" aria-labelledby="titre-page">
    <div class="container stack" style="--flow: var(--space-m)">
      <nav aria-label="Volet académique">
        <ul class="academic-nav">
          <li><a href="/academique/" aria-current="page">Compétences et AC</a></li>
          <li><a href="/academique/journal/">Journal des fiches</a></li>
        </ul>
      </nav>
      <p class="eyebrow">Volet académique</p>
      <h1 id="titre-page">Compétences et apprentissages critiques</h1>
      <p class="lead">
        Chaque AC renvoie aux fiches de réflexion qui en apportent la preuve.
        <span class="todo">À REMPLACER</span>
      </p>
      <p class="annotation">Parcours : à préciser. Adapter les compétences et les AC au référentiel de ton parcours.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-tableau">
    <div class="container">
      <div class="receipt-wrap">
        <div class="receipt stack">
          <h2 id="titre-tableau" class="receipt__title">Tableau des compétences</h2>

          <div class="table-scroll" role="region" aria-labelledby="titre-tableau" tabindex="0">
            <table class="table">
              <caption>Une ligne par AC — codes et intitulés à reprendre du référentiel officiel</caption>
              <thead>
                <tr>
                  <th scope="col">Code</th>
                  <th scope="col">Apprentissage critique</th>
                  <th scope="col">Fiches qui le prouvent</th>
                </tr>
              </thead>

              <!-- Un <tbody> par compétence. Dupliquer pour en ajouter. -->
              <tbody>
                <tr><th scope="rowgroup" colspan="3">Développer</th></tr>
                <tr>
                  <th scope="row">AC34.01</th>
                  <td>Intitulé de l'AC <span class="todo">À REMPLACER</span></td>
                  <td>
                    <ul class="list-reset">
                      <li><a href="/academique/journal/fiche-exemple.html">Fiche exemple</a></li>
                    </ul>
                  </td>
                </tr>
                <tr>
                  <th scope="row">AC34.02</th>
                  <td>Intitulé de l'AC <span class="todo">À REMPLACER</span></td>
                  <td>
                    <ul class="list-reset">
                      <li><a href="/academique/journal/fiche-exemple.html">Fiche exemple</a></li>
                    </ul>
                  </td>
                </tr>
                <tr>
                  <th scope="row">AC34.03</th>
                  <td>Intitulé de l'AC <span class="todo">À REMPLACER</span></td>
                  <td><em>Aucune fiche pour l'instant</em></td>
                </tr>
              </tbody>

              <tbody>
                <tr><th scope="rowgroup" colspan="3">Entreprendre</th></tr>
                <tr>
                  <th scope="row">AC35.01</th>
                  <td>Intitulé de l'AC <span class="todo">À REMPLACER</span></td>
                  <td>
                    <ul class="list-reset">
                      <li><a href="/academique/journal/fiche-exemple.html">Fiche exemple</a></li>
                    </ul>
                  </td>
                </tr>
                <tr>
                  <th scope="row">AC35.02</th>
                  <td>Intitulé de l'AC <span class="todo">À REMPLACER</span></td>
                  <td><em>Aucune fiche pour l'instant</em></td>
                </tr>
              </tbody>
            </table>
          </div>

          <span class="barcode" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>
</main>
</BaseLayout>
