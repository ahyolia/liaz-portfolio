# Copier ce fichier en .env (non versionné) pour tester en local avec `netlify dev`.
# En production, définir ces variables dans Netlify :
# Site configuration > Environment variables

# Identifiant demandé aux profs pour accéder à /academique
PROF_USER=prof

# Mot de passe (choisir quelque chose de long et unique)
PROF_PASS=change-moi
